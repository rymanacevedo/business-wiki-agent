# Copy to .env.local and fill in. Only AI_GATEWAY_API_KEY is required.

# Required: a Vercel AI Gateway key (https://vercel.com/ai-gateway). The free
# tier is enough: Clerk runs openai/gpt-5-mini and the judge mistral/mistral-medium-3.5.
AI_GATEWAY_API_KEY=

# Optional: LangSmith tracing. Leave the key empty and nothing is exported.
# `eve dev` traces to LANGSMITH_PROJECT; `eve eval` (EVAL_RUN_LABEL set) traces
# to business-wiki-agent-evals unless LANGSMITH_EVAL_PROJECT says otherwise.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=business-wiki-agent-local
# LANGSMITH_EVAL_PROJECT=business-wiki-agent-evals
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional local overrides (defaults shown).
# WIKI_STORE_DIR=./.wiki-store
# WIKI_NAMESPACE=demo

# Deployment only (set in the Vercel project env, not needed locally):
# BLOB_READ_WRITE_TOKEN=
