    "lint:fix": "oxlint --fix",
    "review:spec": "bun scripts/review-spec.ts",
    "wiki:seed": "bun scripts/wiki-seed.ts",
    "wiki:build-fixture": "bun scripts/wiki-build-fixture.ts",
    "corpus:generate": "bun scripts/corpus-generate.ts",
    "dev:web": "next dev apps/web",
    "build:web": "next build apps/web"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
