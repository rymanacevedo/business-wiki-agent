    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/connect": "2.5.2",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.137",
