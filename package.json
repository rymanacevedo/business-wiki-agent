{
  "name": "business-wiki-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start",
    "eval": "eve eval",
    "deploy": "eve deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint:boundaries": "depcruise packages",
    "check": "bun run lint && bun run lint:boundaries && bun run typecheck && bun run test",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "review:spec": "bun scripts/review-spec.ts",
    "wiki:seed": "bun scripts/wiki-seed.ts",
    "wiki:build-fixture": "bun scripts/wiki-build-fixture.ts",
    "corpus:generate": "bun scripts/corpus-generate.ts"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.6.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.137",
    "eve": "0.80.1",
    "zod": "^4.6.7"
  }
}
