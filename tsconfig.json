{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "eve/workflow-modules"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "agent/**/*.ts",
    "evals/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts"
  ]
}
